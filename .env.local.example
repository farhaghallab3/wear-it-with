# Copy to .env.local and edit locally. Never paste the key in chat.
YOUCAM_API_KEY=
# Use photos you own, with the photographed adult's permission for processing.
YOUCAM_PERSON_IMAGE=private-inputs/person.png
YOUCAM_GARMENT_IMAGE=private-inputs/garment.png
# Start with one front-facing jacket (outer) or top (upper_body).
YOUCAM_GARMENT_CATEGORY=outer

# Web app (backend/). Generate once, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Local spend guards for try-on (documented ~2 units each). Not a provider billing cap.
TRYON_SESSION_LIMIT=10
TRYON_DAILY_LIMIT=20
